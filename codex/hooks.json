{
  "description": "Independent Codex port of the personal Claude harness. Review in /hooks before activation.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/context_loader.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/session_handoff.py\" hook",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/suggest_compact.py\" reset",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/context_loader.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/session_handoff.py\" hook",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/bash_guard.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/edit_guard.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/format_tracker.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/context_loader.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/session_handoff.py\" hook",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/suggest_compact.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/session_handoff.py\" hook",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/session_handoff.py\" hook",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/stop_gate.py\"",
            "timeout": 90
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/session_handoff.py\" hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
